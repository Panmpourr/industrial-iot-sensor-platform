DB_HOST=localhost
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=apppassword
DB_NAME=appdb

# Limited database account used by the backend in Docker (created by sql/app-user.sql)
DB_APP_USER=iiot_app
DB_APP_PASSWORD=change-me-too

CORS_ORIGIN=http://localhost:3000

# Secret used to sign login tokens (at least 32 characters). Generate your own!
JWT_SECRET=change-me-to-a-long-random-string-of-64-chars
